<Window x:Class="MediaFileRenamer.App.OperationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation History" Height="520" Width="820"
        MinHeight="340" MinWidth="520" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer x:Name="OperationHistoryScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  AutomationProperties.Name="Operation history content">
    <Border MinWidth="648" MinHeight="404"
            Width="{Binding ViewportWidth, ElementName=OperationHistoryScrollViewer}"
            Height="{Binding ViewportHeight, ElementName=OperationHistoryScrollViewer}"
            Padding="24,22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Operation History" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Recent move/copy journals are stored locally for recovery and Undo."
                       Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="HistoryGrid" ItemsSource="{Binding History}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  AutomationProperties.Name="Operation history">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow"
                       BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}; {1}; {2}; {3} files; {4}">
                                <Binding Path="CreatedAt"/>
                                <Binding Path="Operation"/>
                                <Binding Path="Status"/>
                                <Binding Path="FileCount"/>
                                <Binding Path="Error"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=g}" Width="160"/>
                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90"/>
                <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Error}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HistoryStatusTextBlock" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       AutomationProperties.Name="Operation history status"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Undo Last Completed" MinWidth="156" Margin="0,0,8,0"
                        Click="Undo_Click" AutomationProperties.Name="Undo last completed operation"/>
                <Button x:Name="CloseButton" Content="_Close" MinWidth="92"
                        IsCancel="True"
                        Click="Close_Click" AutomationProperties.Name="Close operation history"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
    </ScrollViewer>
</Window>
