<Window x:Class="MediaFileRenamer.App.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Recovery Center" Height="680" Width="1040"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app-icon.ico"
        Loaded="Window_Loaded"
        automation:AutomationProperties.Name="Interrupted operation recovery center">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Recovery Center" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="An earlier move or copy did not reach a final journal state. Review the evidence below. Nothing is changed automatically."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4" Margin="0,0,0,12">
            <ListBox x:Name="RecoveryList"
                     ItemsSource="{Binding Recoveries}"
                     SelectionChanged="RecoveryList_SelectionChanged"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     automation:AutomationProperties.Name="Interrupted operations">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CreatedAt, StringFormat=g}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Operation}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Assessment}"
                                           Foreground="{StaticResource ReviewBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="File evidence" Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,8"/>
            <DataGrid Grid.Row="1" x:Name="RecoveryDetailsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      automation:AutomationProperties.Name="Interrupted operation file evidence">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Companion" Binding="{Binding IsCompanion}" Width="90"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="190"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="2*"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="2*"/>
                    <DataGridTextColumn Header="Assessment" Binding="{Binding Message}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecoveryStatusTextBlock"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       automation:AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                <Button x:Name="RollbackButton" Content="_Roll Back Safely"
                        Width="142" Margin="0,0,8,0"
                        Click="Rollback_Click"
                        automation:AutomationProperties.Name="Safely roll back selected interrupted operation"/>
                <Button x:Name="MarkResolvedButton" Content="_Mark Resolved"
                        Width="126" Margin="0,0,8,0"
                        Click="MarkResolved_Click"
                        automation:AutomationProperties.Name="Mark selected operation manually resolved"/>
                <Button x:Name="CloseButton" Content="_Continue Later" Width="122"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsCancel="True" Click="Close_Click"
                        automation:AutomationProperties.Name="Close recovery center without changes"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
