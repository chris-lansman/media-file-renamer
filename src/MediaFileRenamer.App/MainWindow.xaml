<Window x:Class="MediaFileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media File Renamer" Height="860" Width="1360" MinHeight="420" MinWidth="640"
        Icon="Assets/app-icon.ico" AllowDrop="True" Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="AccessiblePreviewRowStyle" TargetType="DataGridRow"
                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="AutomationProperties.Name">
                    <Setter.Value>
                        <MultiBinding StringFormat="{}{0}; proposed {1}; status {2}">
                            <Binding Path="SourceFileName"/>
                            <Binding Path="DestinationFileName"/>
                            <Binding Path="MatchLabel"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PaneGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowStyle" Value="{StaticResource AccessiblePreviewRowStyle}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2"
              AutomationProperties.Name="Application menu">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings" Click="SettingsMenuItem_Click"/>
                <MenuItem Header="_Operation History" Click="OperationHistoryMenuItem_Click"/>
                <MenuItem Header="_Recovery Center" Click="RecoveryCenterMenuItem_Click"/>
                <MenuItem Header="_Undo Last Operation" Click="UndoLastOperationMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About and Credits" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      AutomationProperties.Name="Media rename workspace">
        <Border MinWidth="944"
                MinHeight="{Binding ViewportHeight, ElementName=MainScrollViewer}"
                Width="{Binding ViewportWidth, ElementName=MainScrollViewer}"
                Padding="22,18,22,20">
        <Grid MinHeight="658">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <Image Source="Assets/app-icon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Media File Renamer" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Add media to match it automatically, review only uncertain changes, then move or copy with confidence."
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,12,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddFilesButton" Content="Add Files" Click="AddFiles_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                            AutomationProperties.Name="Add media files"/>
                    <Button x:Name="AddFolderButton" Content="Add Folder" Click="AddFolder_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="Add media folder"/>
                    <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Style="{StaticResource QuietButtonStyle}" IsEnabled="False"
                            AutomationProperties.Name="Clear staged files"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock x:Name="OutputFolderLabel" Text="STAGING FOLDER"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="OutputFolderTextBox"
                                     TextChanged="OutputFolderTextBox_TextChanged"
                                     AutomationProperties.LabeledBy="{Binding ElementName=OutputFolderLabel}"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseOutput_Click"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Browse for staging folder"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock x:Name="OperationLabel" Text="OPERATION"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="OperationComboBox" SelectedIndex="0" MinWidth="180"
                                  SelectionChanged="OperationComboBox_SelectionChanged"
                                  AutomationProperties.LabeledBy="{Binding ElementName=OperationLabel}">
                            <ComboBoxItem Content="Move to staged folder"/>
                            <ComboBoxItem Content="Copy to staged folder"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock x:Name="PresetLabel" Text="NAMING PRESET"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PresetComboBox" SelectedIndex="0" MinWidth="190"
                                  SelectionChanged="PresetComboBox_SelectionChanged"
                                  AutomationProperties.LabeledBy="{Binding ElementName=PresetLabel}">
                            <ComboBoxItem Content="Plex standard"/>
                            <ComboBoxItem Content="Flat review folder"/>
                            <ComboBoxItem Content="Custom token format"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button x:Name="MatchAllButton" Content="Re-match All" Click="MatchAll_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                                AutomationProperties.Name="Re-match all staged files"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Review Changes" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding PreviewItems.Count, StringFormat={}{0} staged}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="10,3,0,0"/>
                        <TextBlock x:Name="ReviewCountTextBlock" Text="Add files to match automatically"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="10,3,0,0"
                                   AutomationProperties.Name="Review status"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="ReviewFilterComboBox"
                                  MinWidth="132" SelectedIndex="0" Margin="0,0,8,0"
                                  SelectionChanged="ReviewFilterComboBox_SelectionChanged"
                                  AutomationProperties.Name="Filter review items">
                            <ComboBoxItem Content="All items"/>
                            <ComboBoxItem Content="Needs review"/>
                            <ComboBoxItem Content="Matched"/>
                            <ComboBoxItem Content="Failed"/>
                        </ComboBox>
                        <Button x:Name="MatchSelectedButton" Content="Retry Selected" MinWidth="118"
                                Margin="0,0,8,0" Click="MatchSelected_Click" IsEnabled="False"
                                AutomationProperties.Name="Retry matching the selected file"/>
                        <Button x:Name="ChooseSelectedButton" Content="Choose Show..." MinWidth="124"
                                Margin="0,0,8,0" Click="ChooseSelected_Click" IsEnabled="False"
                                AutomationProperties.Name="Choose the movie or show for the selected file"/>
                        <Button x:Name="RetryUnresolvedButton" Content="Retry Unresolved" MinWidth="126"
                                Margin="0,0,8,0" Click="RetryUnresolved_Click" IsEnabled="False"
                                AutomationProperties.Name="Retry unresolved files"/>
                        <Button x:Name="RenameButton" Content="Move files" MinWidth="116"
                                Click="ApplyRename_Click" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                AutomationProperties.Name="Move reviewed files"/>
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="1" x:Name="ReviewGuidancePanel"
                        Margin="0,0,0,10" Padding="14"
                        Background="{DynamicResource ReviewSoftBrush}"
                        BorderBrush="#F0D29A" BorderThickness="1"
                        CornerRadius="6"
                        AutomationProperties.Name="Selected file review guidance">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem.RequiresReview, ElementName=OriginalGrid}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="Why this needs review"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ReviewBrush}"/>
                            <TextBlock Text="{Binding SelectedItem.ReviewReason, ElementName=OriginalGrid}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding SelectedItem.ReviewSuggestion, ElementName=OriginalGrid}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="ResolveReviewButton"
                                    Content="Browse Episodes..." Margin="0,0,8,0"
                                    Click="ResolveReview_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Resolve the selected review"/>
                            <Button x:Name="ChooseDifferentShowButton"
                                    Content="Choose Different Show..."
                                    Click="ChooseSelected_Click"
                                    AutomationProperties.Name="Choose a different movie or show"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="OriginalGrid"
                              Style="{StaticResource PaneGridStyle}"
                              ItemsSource="{Binding PreviewItems}"
                              SelectionChanged="OriginalGrid_SelectionChanged"
                              MinHeight="238"
                              AutomationProperties.Name="Original media files"
                              AutomationProperties.HelpText="Unified review table with original files, proposed destinations, match status, and row actions.">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Original file" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="34" Margin="0,0,8,0"
                                                    Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding PosterUrl}" Stretch="Uniform"
                                                       AutomationProperties.Name="Media poster"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding SourceFileName}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceFileName}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Source folder"
                                                Binding="{Binding SourceFolder}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Proposed name"
                                                Binding="{Binding DestinationFileName}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Destination"
                                                Binding="{Binding DestinationFolder}"
                                                Width="2*"/>
                            <DataGridTemplateColumn Header="Status / provider" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="10"
                                                HorizontalAlignment="Left" ToolTip="{Binding Status}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Matched">
                                                            <Setter Property="Background" Value="{DynamicResource MatchSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#B9E5D1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Review needed">
                                                            <Setter Property="Background" Value="{DynamicResource ReviewSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#F0D29A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Blocked">
                                                            <Setter Property="Background" Value="{DynamicResource BlockedSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#F1B9B4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Manual choice">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#B8DCEB"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Complete">
                                                            <Setter Property="Background" Value="{DynamicResource MatchSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#B9E5D1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MatchLabel}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchState}" Value="Matched">
                                                                <Setter Property="Foreground" Value="{DynamicResource MatchBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchState}" Value="Review needed">
                                                                <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchState}" Value="Blocked">
                                                                <Setter Property="Foreground" Value="{DynamicResource BlockedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchState}" Value="Manual choice">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchState}" Value="Complete">
                                                                <Setter Property="Foreground" Value="{DynamicResource MatchBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="168">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Retry" Padding="9,4" Margin="0,0,6,0"
                                                    Click="MatchRow_Click"
                                                    AutomationProperties.Name="Retry matching this file"/>
                                            <Button Content="Resolve..." Padding="9,4"
                                                    Click="ChooseRow_Click"
                                                    AutomationProperties.Name="Resolve review for this file"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="EmptyDropPanel"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28"
                            Visibility="Visible"
                            AutomationProperties.Name="Empty media workspace">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                            <Border Width="58" Height="58" CornerRadius="29"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="+" FontSize="34" FontWeight="Light"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Drop media files or folders here"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="You can also use Add Files or Add Folder. Nothing is changed until you review the batch and confirm the final operation."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Compatibility marker for automation written against the former
                         proposed-name pane. The visible review experience is one table. -->
                    <Border x:Name="NewNamesGrid" Visibility="Collapsed"
                            AutomationProperties.Name="Proposed media names and review status"/>
                </Grid>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                <Grid x:Name="SelectedFileEditor" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" Text="Selected file" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SelectedTitleLabel"
                               Text="Title" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SelectedTitleTextBox"
                             Text="{Binding SelectedItem.MatchedTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SelectedTitleLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SelectedYearLabel"
                               Text="Year" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="SelectedYearTextBox"
                             MinWidth="78"
                             Text="{Binding SelectedItem.Year, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SelectedYearLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" x:Name="SelectedSeasonLabel"
                               Text="Season" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="SelectedSeasonTextBox"
                             MinWidth="78"
                             Text="{Binding SelectedItem.Season, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SelectedSeasonLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" x:Name="SelectedEpisodeLabel"
                               Text="Episode" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="7" x:Name="SelectedEpisodeTextBox"
                             MinWidth="78"
                             Text="{Binding SelectedItem.Episode, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SelectedEpisodeLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="8" x:Name="SelectedEpisodeTitleLabel"
                               Text="Episode title" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="9" x:Name="SelectedEpisodeTitleTextBox"
                             Text="{Binding SelectedItem.EpisodeTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SelectedEpisodeTitleLabel}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SelectedTypeLabel"
                               Text="Type" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SelectedTypeComboBox"
                              Margin="0,12,10,0" SelectedValuePath="Content"
                              SelectedValue="{Binding SelectedItem.MediaType, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.LabeledBy="{Binding ElementName=SelectedTypeLabel}">
                        <ComboBoxItem Content="Unknown"/>
                        <ComboBoxItem Content="Movie"/>
                        <ComboBoxItem Content="TV"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="EpisodeOrderLabel"
                               Text="Order" VerticalAlignment="Center" Margin="10,12,0,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                              x:Name="EpisodeOrderComboBox" Margin="0,12,10,0"
                              SelectedItem="{Binding SelectedItem.EpisodeOrder, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="TVDB episode order used for this file"
                              AutomationProperties.LabeledBy="{Binding ElementName=EpisodeOrderLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="5" Text="Provider IDs"
                               VerticalAlignment="Center" Margin="10,12,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="4"
                               Margin="14,12,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="TMDB "/>
                        <Run Text="{Binding SelectedItem.TmdbId, ElementName=OriginalGrid, TargetNullValue=—}"/>
                        <Run Text="   TVDB "/>
                        <Run Text="{Binding SelectedItem.TvdbId, ElementName=OriginalGrid, TargetNullValue=—}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="CustomFormatLabel" Text="Custom" VerticalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="9" x:Name="CustomFormatTextBox" Margin="0,12,0,0"
                             TextChanged="CustomFormatTextBox_TextChanged"
                             ToolTip="Tokens: {Title}, {Year}, {Season}, {Episode}, {EpisodeEnd}, {AirDate}, {AbsoluteEpisode}, {Part}, {EpisodeTitle}, {TmdbId}, {TvdbId}, {ProviderId}, {Edition}, {EditionTag}"
                              Text="Movies\{Title} ({Year}) {TmdbId}\{Title} ({Year}) {TmdbId}" Visibility="Collapsed"
                              AutomationProperties.LabeledBy="{Binding ElementName=CustomFormatLabel}"/>

                    <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="10"
                               Margin="0,12,0,0">
                        <Button x:Name="ConfirmManualDetailsButton"
                                Content="Confirm Edited Details" Margin="0,0,8,0"
                                Click="ConfirmManualDetails_Click"
                                IsEnabled="{Binding SelectedItem.CanConfirmManualDetails, ElementName=OriginalGrid}"
                                AutomationProperties.Name="Confirm the manually edited media details"/>
                        <Button x:Name="RememberShowMappingButton"
                                Content="Always use this show for this folder"
                                Click="RememberShowMapping_Click"
                                IsEnabled="False"
                                AutomationProperties.Name="Remember selected show for its source folder"/>
                        <TextBlock x:Name="RememberShowMappingStatusTextBlock"
                                   Margin="10,7,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Remembered show mapping status"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </WrapPanel>
                </Grid>

                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="10,7"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="StatusTextBlock" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                       Margin="14,0,0,0"
                                       Text="Drop media files here, or use Add Files / Add Folder."
                                       AutomationProperties.Name="Application status"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button Grid.Column="2" x:Name="CancelOperationButton" Content="Cancel"
                                    Margin="10,0,0,0" Padding="12,4"
                                    Visibility="Collapsed" Click="CancelOperation_Click"
                                    AutomationProperties.Name="Cancel current operation"/>
                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                         x:Name="OperationProgressBar" Height="6" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed"
                                         AutomationProperties.Name="Operation progress"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
