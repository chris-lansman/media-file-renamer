<Window x:Class="MediaFileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media File Renamer" Height="860" Width="1360" MinHeight="760" MinWidth="1120"
        Icon="Assets/app-icon.ico" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PaneGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="HeadersVisibility" Value="Column"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings" Click="SettingsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <Image Source="Assets/app-icon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Media File Renamer" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Stage clean Plex-friendly names, review every change, then move or copy with confidence."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddFilesButton" Content="Add Files" Click="AddFiles_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="AddFolderButton" Content="Add Folder" Click="AddFolder_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Style="{StaticResource QuietButtonStyle}" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="STAGING FOLDER" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="OutputFolderTextBox" TextChanged="OutputFolderTextBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseOutput_Click" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="OPERATION" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="OperationComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="Move to staged folder"/>
                            <ComboBoxItem Content="Copy to staged folder"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="NAMING PRESET" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PresetComboBox" SelectedIndex="0" SelectionChanged="PresetComboBox_SelectionChanged">
                            <ComboBoxItem Content="Plex standard"/>
                            <ComboBoxItem Content="Flat review folder"/>
                            <ComboBoxItem Content="Custom token format"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button x:Name="MatchAllButton" Content="Match All" Click="MatchAll_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                    <TextBlock Text="Original Files" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding PreviewItems.Count, StringFormat={}{0} staged}" Foreground="{StaticResource MutedTextBrush}" Margin="10,3,0,0"/>
                </DockPanel>
                <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Proposed Names" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Match confidence" Foreground="{StaticResource MutedTextBrush}" Margin="10,3,0,0"/>
                </DockPanel>

                <DataGrid Grid.Row="1" Grid.Column="0" x:Name="OriginalGrid" Style="{StaticResource PaneGridStyle}"
                          ItemsSource="{Binding PreviewItems}" SelectionChanged="OriginalGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Original file" Binding="{Binding SourceFileName}" Width="3*"/>
                        <DataGridTextColumn Header="Source folder" Binding="{Binding SourceFolder}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="132">
                    <TextBlock Text="REVIEW SELECTED" Style="{StaticResource FieldLabelStyle}" TextAlignment="Center" Margin="0,0,0,10"/>
                    <Button x:Name="MatchSelectedButton" Content="Match" Width="132" Margin="0,0,0,8" Click="MatchSelected_Click" IsEnabled="False"/>
                    <Button x:Name="ChooseSelectedButton" Content="Choose..." Width="132" Margin="0,0,0,14" Click="ChooseSelected_Click" IsEnabled="False"/>
                    <Button x:Name="RenameButton" Content="Apply Rename" Width="132" Margin="0" Click="ApplyRename_Click"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                </StackPanel>

                <DataGrid Grid.Row="1" Grid.Column="2" x:Name="NewNamesGrid" Style="{StaticResource PaneGridStyle}"
                          ItemsSource="{Binding PreviewItems}" SelectionChanged="NewNamesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proposed file name" Binding="{Binding DestinationFileName}" Width="3*"/>
                        <DataGridTextColumn Header="Destination folder" Binding="{Binding DestinationFolder}" Width="2*"/>
                        <DataGridTemplateColumn Header="Match" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="10" HorizontalAlignment="Left" ToolTip="{Binding Status}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchState}" Value="Matched">
                                                        <Setter Property="Background" Value="{StaticResource MatchSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#B9E5D1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchState}" Value="Review needed">
                                                        <Setter Property="Background" Value="{StaticResource ReviewSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#F0D29A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchState}" Value="Blocked">
                                                        <Setter Property="Background" Value="{StaticResource BlockedSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#F1B9B4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchState}" Value="Manual choice">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#B8DCEB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchState}" Value="Complete">
                                                        <Setter Property="Background" Value="{StaticResource MatchSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#B9E5D1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding MatchState}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Matched">
                                                            <Setter Property="Foreground" Value="{StaticResource MatchBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Review needed">
                                                            <Setter Property="Foreground" Value="{StaticResource ReviewBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Blocked">
                                                            <Setter Property="Foreground" Value="{StaticResource BlockedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Manual choice">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchState}" Value="Complete">
                                                            <Setter Property="Foreground" Value="{StaticResource MatchBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" Text="Selected file" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Title" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.MatchedTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Year" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedItem.Year, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Season" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding SelectedItem.Season, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="Episode" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding SelectedItem.Episode, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="8" Text="Episode title" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding SelectedItem.EpisodeTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,10,0" SelectedValuePath="Content"
                              SelectedValue="{Binding SelectedItem.MediaType, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Unknown"/>
                        <ComboBoxItem Content="Movie"/>
                        <ComboBoxItem Content="TV"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="CustomFormatLabel" Text="Custom" VerticalAlignment="Center" Margin="10,12,0,0" Visibility="Collapsed"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="7" x:Name="CustomFormatTextBox" Margin="0,12,0,0"
                             TextChanged="CustomFormatTextBox_TextChanged"
                             ToolTip="Tokens: {Title}, {Year}, {Season}, {Episode}, {EpisodeTitle}, {TmdbId}"
                             Text="Movies\{Title} ({Year}) {TmdbId}\{Title} ({Year}) {TmdbId}" Visibility="Collapsed"/>

                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="10" Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="10,7" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Status" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="StatusTextBlock" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                       Text="Drop media files here, or use Add Files / Add Folder."/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
