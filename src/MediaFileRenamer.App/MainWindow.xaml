<Window x:Class="MediaFileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media File Renamer" Height="860" Width="1360" MinHeight="760" MinWidth="1120"
        Icon="Assets/app-icon.ico"
        Background="#F4F6F8" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaneGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCD3DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F6FA7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#255B89"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings" Click="SettingsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddFilesButton" Content="Add Files" Click="AddFiles_Click"/>
                <Button x:Name="AddFolderButton" Content="Add Folder" Click="AddFolder_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" IsEnabled="False"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Media File Renamer" FontSize="26" FontWeight="SemiBold" Foreground="#20262E"/>
                <TextBlock Text="Review each original file beside its staged Plex-friendly name before applying changes."
                           Foreground="#566171" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Output folder" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="OutputFolderTextBox"
                         TextChanged="OutputFolderTextBox_TextChanged"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="BrowseOutput_Click" Margin="8,0,14,0"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Operation" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="4" x:Name="OperationComboBox" SelectedIndex="0" Margin="0,0,14,0">
                    <ComboBoxItem Content="Move to staged folder"/>
                    <ComboBoxItem Content="Copy to staged folder"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="5" Text="Preset" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="6" x:Name="PresetComboBox" SelectedIndex="0" SelectionChanged="PresetComboBox_SelectionChanged">
                    <ComboBoxItem Content="Plex standard"/>
                    <ComboBoxItem Content="Flat review folder"/>
                    <ComboBoxItem Content="Custom token format"/>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="7" x:Name="MatchAllButton" Content="Match All" Click="MatchAll_Click" Margin="12,0,0,0" IsEnabled="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Original Files" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="New Names" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <DataGrid Grid.Row="1" Grid.Column="0" x:Name="OriginalGrid" Style="{StaticResource PaneGridStyle}"
                      ItemsSource="{Binding PreviewItems}" SelectionChanged="OriginalGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding SourceFileName}" Width="2*"/>
                    <DataGridTextColumn Header="Folder" Binding="{Binding SourceFolder}" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="75"/>
                    <DataGridTextColumn Header="Ext" Binding="{Binding ExtensionLabel}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="MatchSelectedButton" Content="Match Selected" Width="120" Margin="0,0,0,10" Click="MatchSelected_Click" IsEnabled="False"/>
                <Button x:Name="ChooseSelectedButton" Content="Choose Match..." Width="120" Margin="0,0,0,10" Click="ChooseSelected_Click" IsEnabled="False"/>
                <Button x:Name="RenameButton" Content="Apply Rename" Width="120" Margin="0" Click="ApplyRename_Click"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
            </StackPanel>

            <DataGrid Grid.Row="1" Grid.Column="2" x:Name="NewNamesGrid" Style="{StaticResource PaneGridStyle}"
                      ItemsSource="{Binding PreviewItems}" SelectionChanged="NewNamesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="New file" Binding="{Binding DestinationFileName}" Width="2*"/>
                    <DataGridTextColumn Header="Destination folder" Binding="{Binding DestinationFolder}" Width="2*"/>
                    <DataGridTextColumn Header="Ext" Binding="{Binding ExtensionLabel}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.MatchedTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Year" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedItem.Year, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Season" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding SelectedItem.Season, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Episode" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding SelectedItem.Episode, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="Episode title" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="9" Text="{Binding SelectedItem.EpisodeTitle, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,10,0" SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedItem.MediaType, ElementName=OriginalGrid, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Unknown"/>
                    <ComboBoxItem Content="Movie"/>
                    <ComboBoxItem Content="TV"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="CustomFormatLabel" Text="Custom" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
                <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="7" x:Name="CustomFormatTextBox" Margin="0,10,0,0"
                         TextChanged="CustomFormatTextBox_TextChanged"
                         ToolTip="Tokens: {Title}, {Year}, {Season}, {Episode}, {EpisodeTitle}, {TmdbId}"
                         Text="Movies\{Title} ({Year}) {TmdbId}\{Title} ({Year}) {TmdbId}" Visibility="Collapsed"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10" x:Name="StatusTextBlock" VerticalAlignment="Center"
                           Foreground="#566171" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Drop media files here, or use Add Files / Add Folder."/>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
