<Window x:Class="MediaFileRenamer.App.MatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Choose Match" Height="700" Width="980" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer x:Name="MatchPickerScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  automation:AutomationProperties.Name="Metadata match picker">
    <Border x:Name="PickerContentBorder" MinWidth="808" MinHeight="544"
            Width="{Binding ViewportWidth, ElementName=MatchPickerScrollViewer}"
            Height="{Binding ViewportHeight, ElementName=MatchPickerScrollViewer}"
            Padding="24,22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="PickerHeadingTextBlock" Text="Choose the correct match"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="SourceTextBlock" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="OnlineSearchPanel" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchTextBox" MinHeight="36" VerticalContentAlignment="Center"
                     KeyDown="SearchTextBox_KeyDown"
                     automation:AutomationProperties.Name="Movie or show title to search"/>
            <Button Grid.Column="1" x:Name="SearchButton" Content="Search" MinWidth="94"
                    Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Search_Click"
                    automation:AutomationProperties.Name="Search metadata providers"/>
        </Grid>

        <Grid Grid.Row="2" x:Name="ProviderResultsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="CandidateList" ItemsSource="{Binding Candidates}" MouseDoubleClick="CandidateList_MouseDoubleClick"
                 SelectionChanged="CandidateList_SelectionChanged"
                 automation:AutomationProperties.Name="Metadata match candidates"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="4">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="automation:AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}, {1}, {2}, {3}">
                                <Binding Path="Title"/>
                                <Binding Path="Year"/>
                                <Binding Path="MediaType"/>
                                <Binding Path="ProviderLabel"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                           Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}"
                                           Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                            BorderBrush="#E1E8EF" BorderThickness="0,0,0,1" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="78" Height="116" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" MaxWidth="600"/>
                                    <TextBlock Text="{Binding Year, StringFormat=  ({0})}" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" Margin="6,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding MediaType}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProviderLabel, StringFormat=  • {0}}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProviderIds, StringFormat=  • {0}}" Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"
                                           MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </Border>
            <TextBlock Grid.Row="0" x:Name="SearchStatusTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="520" IsHitTestVisible="False"
                       automation:AutomationProperties.Name="Metadata search status"
                       automation:AutomationProperties.LiveSetting="Polite"/>
            <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="5">
                <TextBlock x:Name="CandidateEvidenceTextBlock"
                           Text="Select a result to see why it matches."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"
                           automation:AutomationProperties.Name="Selected match confidence evidence"
                           automation:AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" x:Name="LocalClassificationPanel"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Choose how this file should be organized"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="Online matching is not configured. Classify the file locally now, or add provider credentials later in Settings."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="LocalMovieButton" Content="Use as Movie" MinWidth="126"
                            Margin="0,0,10,0" Click="UseAsMovie_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            automation:AutomationProperties.Name="Classify locally as movie"/>
                    <Button x:Name="LocalTvButton" Content="Use as TV Episode" MinWidth="142"
                            Click="UseAsTv_Click"
                            automation:AutomationProperties.Name="Classify locally as television"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel x:Name="OnlineLocalChoicePanel" DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Use as Movie" MinWidth="116" Margin="0,0,8,0"
                        Click="UseAsMovie_Click"
                        automation:AutomationProperties.Name="Classify locally as movie"/>
                <Button Content="Use as TV" MinWidth="104" Click="UseAsTv_Click"
                        automation:AutomationProperties.Name="Classify locally as television"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="_Cancel" MinWidth="92"
                        Margin="0,0,8,0" Style="{StaticResource QuietButtonStyle}"
                        IsCancel="True" Click="Cancel_Click"
                        automation:AutomationProperties.Name="Cancel match selection"/>
                <Button x:Name="UseSelectedButton" Content="Use Selected" MinWidth="124"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                        Click="UseSelected_Click"
                        automation:AutomationProperties.Name="Use selected metadata match"/>
            </StackPanel>
            <TextBlock x:Name="OnlineSelectionHint" Text="Double-click a result to choose it." VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
        </DockPanel>
    </Grid>
    </Border>
    </ScrollViewer>
</Window>
