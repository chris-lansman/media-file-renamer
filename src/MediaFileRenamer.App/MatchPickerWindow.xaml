<Window x:Class="MediaFileRenamer.App.MatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Match" Height="700" Width="980" MinHeight="580" MinWidth="840"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Choose the correct match" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="SourceTextBlock" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchTextBox" MinHeight="36" VerticalContentAlignment="Center"
                     KeyDown="SearchTextBox_KeyDown"/>
            <Button Grid.Column="1" Content="Search" Width="94" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Search_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="CandidateList" ItemsSource="{Binding Candidates}" MouseDoubleClick="CandidateList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="4">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                            BorderBrush="#E1E8EF" BorderThickness="0,0,0,1" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="78" Height="116" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" MaxWidth="600"/>
                                    <TextBlock Text="{Binding Year, StringFormat=  ({0})}" FontSize="16" Foreground="{StaticResource MutedTextBrush}" Margin="6,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MediaType}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"
                                           MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </Border>
            <TextBlock x:Name="SearchStatusTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="520" IsHitTestVisible="False"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Use as Movie" Width="116" Margin="0,0,8,0" Click="UseAsMovie_Click"/>
                <Button Content="Use as TV" Width="104" Click="UseAsTv_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Width="92" Margin="0,0,8,0" Style="{StaticResource QuietButtonStyle}" Click="Cancel_Click"/>
                <Button Content="Use Selected" Width="124" Style="{StaticResource PrimaryButtonStyle}" Click="UseSelected_Click"/>
            </StackPanel>
            <TextBlock Text="Double-click a result to choose it." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
