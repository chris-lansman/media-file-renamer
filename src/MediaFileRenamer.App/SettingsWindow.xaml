<Window x:Class="MediaFileRenamer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="530" Width="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Metadata sources and default staging preferences for this Windows user."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="TMDB API key" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TmdbApiKeyBox" MinHeight="32"/>

                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="UseTmdbLookupCheckBox"
                          Content="Use TMDB lookup when matching" IsChecked="True" Margin="0,12,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="TVDB API key" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TvdbApiKeyBox" MinHeight="32" Margin="0,14,0,0"/>

                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="UseTvdbFallbackCheckBox"
                          Content="Use TVDB as fallback when available" IsChecked="True" Margin="0,12,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Output folder" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DefaultOutputFolderTextBox" Margin="0,14,8,0"/>
                <Button Grid.Row="4" Grid.Column="2" Content="Browse" MinHeight="32" Margin="0,14,0,0" Click="BrowseOutput_Click"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Auto-match" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox x:Name="AutoMatchConfidenceTextBox" Width="64"/>
                    <TextBlock Text="% confidence before choosing automatically" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Settings file" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,14,0,0"/>
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SettingsPathTextBox" Margin="0,14,0,0"
                         IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0" Style="{StaticResource QuietButtonStyle}" Click="Cancel_Click"/>
            <Button Content="Save Settings" Width="112" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
