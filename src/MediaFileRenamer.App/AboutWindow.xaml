<Window x:Class="MediaFileRenamer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="About Media File Renamer"
        Width="620" Height="620" MinWidth="520" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/app-icon.ico"
        automation:AutomationProperties.Name="About Media File Renamer">
    <Window.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/app-icon.png" Width="48" Height="48"
                       automation:AutomationProperties.Name="Media File Renamer icon"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Media File Renamer" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionTextBlock" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      automation:AutomationProperties.Name="About content">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Bring your own credentials" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="BringYourOwnCredentialsTextBlock"
                                   Margin="0,7,0,0" TextWrapping="Wrap"
                                   Text="Media File Renamer does not include, share, or proxy provider credentials. Each user supplies and manages their own TMDB and TVDB credentials on their personal computer."/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                                   Text="Updates are checked only when you choose the button below. No telemetry or personal information is sent."/>
                        <TextBlock x:Name="UpdateStatusTextBlock"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Update status has not been checked."
                                   automation:AutomationProperties.Name="Update check status"
                                   automation:AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckForUpdatesButton" Content="Check for _updates"
                                    Click="CheckForUpdates_Click"
                                    automation:AutomationProperties.Name="Check for updates"/>
                            <Button x:Name="OpenReleaseButton" Content="_Open release page"
                                    Margin="8,0,0,0"
                                    Click="OpenRelease_Click"
                                    automation:AutomationProperties.Name="Open latest release download page"/>
                            <Button x:Name="InstallUpdateButton" Content="_Install update"
                                    Margin="8,0,0,0" Visibility="Collapsed"
                                    Click="InstallUpdate_Click"
                                    automation:AutomationProperties.Name="Download, verify, and install available update"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Approved TMDB primary full logo from themoviedb.org/about/logos-attribution. -->
                        <Viewbox x:Name="TmdbLogo" Width="90" Height="65"
                                 HorizontalAlignment="Left" Stretch="Uniform"
                                 automation:AutomationProperties.Name="The Movie Database logo">
                            <Canvas Width="185.04" Height="133.4">
                                <Path Data="M51.06,66.7h0A17.67,17.67,0,0,1,68.73,49h-.1A17.67,17.67,0,0,1,86.3,66.7h0A17.67,17.67,0,0,1,68.63,84.37h.1A17.67,17.67,0,0,1,51.06,66.7Zm82.67-31.33h32.9A17.67,17.67,0,0,0,184.3,17.7h0A17.67,17.67,0,0,0,166.63,0h-32.9A17.67,17.67,0,0,0,116.06,17.7h0A17.67,17.67,0,0,0,133.73,35.37Zm-113,98h63.9A17.67,17.67,0,0,0,102.3,115.7h0A17.67,17.67,0,0,0,84.63,98H20.73A17.67,17.67,0,0,0,3.06,115.7h0A17.67,17.67,0,0,0,20.73,133.37Zm83.92-49h6.25L125.5,49h-8.35l-8.9,23.2h-.1L99.4,49H90.5Zm32.45,0h7.8V49h-7.8Zm22.2,0h24.95V77.2H167.1V70h15.35V62.8H167.1V56.2h16.25V49h-24ZM10.1,35.4h7.8V6.9H28V0H0V6.9H10.1ZM39,35.4h7.8V20.1H61.9V35.4h7.8V0H61.9V13.2H46.75V0H39Zm41.25,0h25V28.2H88V21h15.35V13.8H88V7.2h16.25V0h-24Zm-79,49H9V57.25h.1l9,27.15H24l9.3-27.15h.1V84.4h7.8V49H29.45l-8.2,23.1h-.1L13,49H1.2Zm112.09,49H126a24.59,24.59,0,0,0,7.56-1.15,19.52,19.52,0,0,0,6.35-3.37,16.37,16.37,0,0,0,4.37-5.5A16.91,16.91,0,0,0,146,115.8a18.5,18.5,0,0,0-1.68-8.25,15.1,15.1,0,0,0-4.52-5.53A18.55,18.55,0,0,0,133.07,99,33.54,33.54,0,0,0,125,98H113.29Zm7.81-28.2h4.6a17.43,17.43,0,0,1,4.67.62,11.68,11.68,0,0,1,3.88,1.88,9,9,0,0,1,2.62,3.18,9.87,9.87,0,0,1,1,4.52,11.92,11.92,0,0,1-1,5.08,8.69,8.69,0,0,1-2.67,3.34,10.87,10.87,0,0,1-4,1.83,21.57,21.57,0,0,1-5,.55H121.1Zm36.14,28.2h14.5a23.11,23.11,0,0,0,4.73-.5,13.38,13.38,0,0,0,4.27-1.65,9.42,9.42,0,0,0,3.1-3,8.52,8.52,0,0,0,1.2-4.68,9.16,9.16,0,0,0-.55-3.2,7.79,7.79,0,0,0-1.57-2.62,8.38,8.38,0,0,0-2.45-1.85,10,10,0,0,0-3.18-1v-.1a9.28,9.28,0,0,0,4.43-2.82,7.42,7.42,0,0,0,1.67-5,8.34,8.34,0,0,0-1.15-4.65,7.88,7.88,0,0,0-3-2.73,12.9,12.9,0,0,0-4.17-1.3,34.42,34.42,0,0,0-4.63-.32h-13.2Zm7.8-28.8h5.3a10.79,10.79,0,0,1,1.85.17,5.77,5.77,0,0,1,1.7.58,3.33,3.33,0,0,1,1.23,1.13,3.22,3.22,0,0,1,.47,1.82,3.63,3.63,0,0,1-.42,1.8,3.34,3.34,0,0,1-1.13,1.2,4.78,4.78,0,0,1-1.57.65,8.16,8.16,0,0,1-1.78.2H165Zm0,14.15h5.9a15.12,15.12,0,0,1,2.05.15,7.83,7.83,0,0,1,2,.55,4,4,0,0,1,1.58,1.17,3.13,3.13,0,0,1,.62,2,3.71,3.71,0,0,1-.47,1.95,4,4,0,0,1-1.23,1.3,4.78,4.78,0,0,1-1.67.7,8.91,8.91,0,0,1-1.83.2h-7Z">
                                    <Path.Fill>
                                        <LinearGradientBrush MappingMode="Absolute"
                                                             StartPoint="0,66.7"
                                                             EndPoint="185.04,66.7">
                                            <GradientStop Offset="0" Color="#90CEA1"/>
                                            <GradientStop Offset="0.56" Color="#3CBEC9"/>
                                            <GradientStop Offset="1" Color="#00B3E5"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TmdbNoticeTextBlock"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="This product uses the TMDB API but is not endorsed or certified by TMDB."/>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink NavigateUri="https://www.themoviedb.org/"
                                       RequestNavigate="Link_RequestNavigate"
                                       automation:AutomationProperties.Name="Visit The Movie Database website">
                                Visit The Movie Database
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TheTVDB" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   automation:AutomationProperties.Name="TheTVDB"/>
                        <TextBlock x:Name="TvdbAttributionTextBlock"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="TV metadata and artwork are provided by TheTVDB. TheTVDB is not affiliated with or responsible for this application."/>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink NavigateUri="https://thetvdb.com/"
                                       RequestNavigate="Link_RequestNavigate"
                                       automation:AutomationProperties.Name="Visit TheTVDB website">
                                Visit TheTVDB
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyDiagnosticsButton" Content="_Copy diagnostic summary"
                    HorizontalAlignment="Left" Click="CopyDiagnostics_Click"
                    automation:AutomationProperties.Name="Copy diagnostic summary"/>
            <Button Grid.Column="1" Content="_Close" IsCancel="True" MinWidth="92"
                    Style="{StaticResource PrimaryButtonStyle}"
                    automation:AutomationProperties.Name="Close About window"/>
        </Grid>
    </Grid>
</Window>
